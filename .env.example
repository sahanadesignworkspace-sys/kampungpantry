# GEMINI_API_KEY: Required if Gemini AI API calls are enabled on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_VOLUNTEER_PIN: Passcode for authorised community volunteers / admins
# to access fridge temperature logs and safety moderation. Demo default: 2026
ADMIN_VOLUNTEER_PIN="2026"

# THEMEALDB_API_KEY: Optional custom/Patreon key for TheMealDB.
# Leave blank to use TheMealDB's free keyless public v1 endpoint (/api/json/v1/1).
THEMEALDB_API_KEY=""
THEMEALDB_BASE_URL="https://www.themealdb.com/api/json/v1"

